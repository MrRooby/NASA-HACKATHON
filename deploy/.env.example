# Template for deploy/.env (copy, then fill in). The real deploy/.env is git-ignored and never committed.
# Placeholders only - generate strong passwords, e.g. `openssl rand -base64 24`.

# --- MariaDB accounts (created by DATABASE/schema/003_users.sh on the FIRST start of an empty volume) ---
MARIADB_ROOT_PASSWORD=change-me
ASTRO_ETL_PASSWORD=change-me
ASTRO_READER_PASSWORD=change-me
ASTRO_ADMIN_PASSWORD=change-me
HABITAT_WRITER_PASSWORD=change-me

# --- Where ports are published: the server's Tailscale IP (`tailscale ip -4`). 127.0.0.1 = local only. ---
BIND_IP=127.0.0.1
DB_PUBLISH_PORT=3306
MOTHER_PUBLISH_PORT=8000
GUI_PUBLISH_PORT=8081

# --- Image version from GHCR: latest, or a release tag without "v" prefix (e.g. 0.1.0) for pinning/rollback ---
IMAGE_TAG=latest

# --- Optional: point MOTHER at an existing database instead of the bundled mariadb service ---
# MOTHER_DB_HOST=mariadb
# MOTHER_DB_PORT=3306
# MOTHER_MISSION=
