    },
    {
      "id": "bmd_femoral_neck_pct_baseline",
      "label": "Bone mineral density (femoral neck) vs preflight",
      "unit": "% of baseline",
      "category": "musculoskeletal",
      "evaluation": "baseline_percent",
      "bands": [
        { "max": 90, "status": "alert", "basis": "source", "message": "Below 90% of preflight femoral-neck BMD (NASA standard).", "escalate": true },
        { "min": 90, "max": 93, "status": "caution", "basis": "team_assumption", "message": "Approaching NASA minimum." },
        { "min": 93, "status": "ok", "basis": "source", "message": "Within standard." }
      ],
      "projection": "With ARED ~0.32%/month femoral-neck loss.",
      "sources": ["nasa_std_3001_v1", "hrr_er_bone"]
    },

    {
      "id": "reaction_time_pct_change",
      "label": "Reaction time vs own baseline (PVT)",
      "unit": "% slower",
      "category": "behavioral",
      "evaluation": "baseline_percent_change",
      "bands": [
        { "max": 10, "status": "ok", "basis": "team_assumption", "message": "Reaction time within 10% of your baseline." },
        { "min": 10, "max": 20, "status": "caution", "basis": "team_assumption", "message": "Reaction time 10-20% slower than your baseline.", "action": "Check sleep, fatigue and CO2 exposure; repeat the test in 24 h." },
        { "min": 20, "status": "alert", "basis": "team_assumption", "message": "Reaction time 20% or more slower than your baseline.", "action": "Avoid critical tasks until reviewed; consider a private psychological conference.", "escalate": true }
      ],
      "spaceflight_context": "Performance indicator compared with the person's own baseline (preflight or the first in-app tests), not a diagnosis.",
      "sources": ["basner_2024", "basner_2011_pvtb", "ntrs_space_psych"]
    },
    {
      "id": "pvt_lapses",
      "label": "PVT lapses (responses of 355 ms or more)",
      "unit": "count",
      "category": "behavioral",
      "evaluation": "absolute",
