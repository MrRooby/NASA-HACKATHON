# Wzór pliku DATABASE/.env (skopiuj do DATABASE/.env i uzupełnij). Prawdziwego .env NIE commitujemy.
MARIADB_ROOT_PASSWORD=
ASTRO_ETL_PASSWORD=
ASTRO_ADMIN_PASSWORD=admin
HABITAT_WRITER_PASSWORD=
COGNITIVE_WRITER_PASSWORD=
ASTRO_READER_PASSWORD=

# Adres, na którym docker wystawia port (Tailscale IP serwera bazy; `tailscale ip -4`)
DB_BIND_IP=100.118.238.112

# Dla backendu (odczyt) - z innych maszyn w tailnecie: DB_HOST = Tailscale IP serwera
DB_HOST=100.118.238.112
DB_PORT=3306
DB_NAME=astro_api
DB_USER=astro_reader
DB_PASSWORD=
