      "columns": [
        {
          "name": "date_utc",
          "unit": "YYYY-MM-DD (UTC Earth date, not sol)"
        },
        {
          "name": "n_obs",
          "unit": "count",
          "description": "number of RAD observations in the day (nominal cadence ~16 min, often ~1 h in L2)"
        },
        {
          "name": "total_dose_b_uGy_per_day_mean",
          "unit": "uGy/day",
          "description": "daily mean of quality-filtered observation dose rates; absorbed dose rate in silicon detector B, total (includes MMRTG background)"
        },
        {
          "name": "rtg_corrected_dose_b_uGy_per_day_mean",
          "unit": "uGy/day",
          "description": "daily mean of quality-filtered observation dose rates; absorbed dose rate in silicon detector B with MMRTG (rover power source) contribution subtracted"
        },
        {
          "name": "total_dose_e_uGy_per_day_mean",
          "unit": "uGy/day",
          "description": "daily mean of quality-filtered observation dose rates; absorbed dose rate in detector E (tissue-equivalent plastic)"
        },
        {
          "name": "total_dose_b_uGy_per_day_min",
          "unit": "uGy/day"
        },
        {
          "name": "total_dose_b_uGy_per_day_max",
          "unit": "uGy/day"
        },
        {
          "name": "rtg_corrected_dose_b_uGy_per_day_min",
          "unit": "uGy/day"
        },
        {
          "name": "rtg_corrected_dose_b_uGy_per_day_max",
          "unit": "uGy/day"
        },
        {
          "name": "total_dose_e_uGy_per_day_min",
          "unit": "uGy/day"
        },
        {
          "name": "total_dose_e_uGy_per_day_max",
          "unit": "uGy/day"
        }
      ],
      "note": "dates 2012-08-17 .. 2026-11-11"
